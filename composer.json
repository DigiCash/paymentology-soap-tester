{
    "name": "digicash/paymentology-soap-tester",
    "description": "PHP 8.4 cURL-based SOAP testing suite and client wrapper for Paymentology (Flexpay) web services.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "DigiCash\\PaymentologySoapTester\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DigiCash\\PaymentologySoapTester\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
